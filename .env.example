# Публичный URL сайта (для canonical, sitemap, Open Graph)
VITE_SITE_URL=https://marcony-krd.ru

# Яндекс Метрика — номер счётчика (оставьте пустым до регистрации)
VITE_YM_COUNTER_ID=

# Dev proxy для frontend -> API
VITE_API_PROXY_TARGET=http://localhost:3000

# PostgreSQL
POSTGRES_DB=marconi
POSTGRES_USER=marconi
POSTGRES_PASSWORD=marconi_dev_password

# API
PERSONAL_DATA_CONSENT_VERSION=2026-07-07
MARKETING_CONSENT_VERSION=2026-07-07
SMS_PROVIDER=log
EXPOSE_DEBUG_OTP=true
