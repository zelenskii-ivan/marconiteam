{
  "name": "marconi-bakery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx api/src/server.ts",
    "prebuild": "node scripts/generate-icons.mjs && node scripts/generate-images.mjs",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p tsconfig.api.json",
    "start:api": "node dist-api/server.js",
    "migrate:api": "tsx api/src/migrate.ts",
    "release:check": "bash scripts/release-check.sh",
    "smoke": "bash scripts/smoke-check.sh",
    "lint": "oxlint",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "images": "node scripts/generate-images.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.1.0",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/golos-text": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
